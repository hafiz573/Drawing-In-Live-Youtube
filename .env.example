# ---------------------------------------------------------------------------
# Salin file ini jadi `.env`, lalu isi nilainya.
#   cp .env.example .env         (PowerShell: Copy-Item .env.example .env)
# ---------------------------------------------------------------------------

# Kunci penanda tangan cookie sesi. WAJIB diisi, minimal 32 karakter acak.
# Bikin cepat:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=aaaa

# --- Google OAuth ----------------------------------------------------------
# Ambil dari https://console.cloud.google.com/apis/credentials
# Jenis kredensial: "OAuth client ID" → "Web application".
# Authorized redirect URI harus sama persis dengan OAUTH_REDIRECT_URI di bawah.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Aplikasi --------------------------------------------------------------
PORT=3000

# Set 'production' saat deploy ke domain asli — menyalakan flag Secure pada
# cookie sesi. Wajib untuk lolos verifikasi OAuth Google.
# NODE_ENV=production

# Origin publik aplikasi. Dipakai untuk membuat link penonton & URL overlay,
# dan sebagai redirect URI kalau OAUTH_REDIRECT_URI tidak diisi.
# Isi saat di belakang reverse proxy, CDN, atau tunnel (ngrok/cloudflared).
# PUBLIC_ORIGIN=https://drawinglive.app

# --- Database (Postgres cloud) ---------------------------------------------
# WAJIB. Tempel connection string dari penyedia Postgres gratis, misalnya:
#
#   Neon      https://neon.tech        → Dashboard → Connection string
#             postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#
#   Supabase  https://supabase.com     → Project Settings → Database → Connection string (URI)
#             postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
#
# Skema tabel dibuat otomatis saat server pertama kali start.
DATABASE_URL=

# TLS ke database. Kosongkan saja — server otomatis menyalakan SSL untuk host
# cloud dan mematikannya untuk localhost. Isi manual kalau perlu:
#   true   = SSL tanpa verifikasi sertifikat (default untuk host cloud)
#   strict = SSL dengan verifikasi sertifikat penuh
#   false  = tanpa SSL
# DB_SSL=

# Batas koneksi bersamaan. Turunkan kalau paket database cloud kamu kecil.
# PGPOOL_MAX=8
